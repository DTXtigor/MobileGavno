  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::StartDialogueCore
  _dialogue: {fileID: 0}
  _russian:
  - texts:
    - "\u041B\u0443\u0447\u0448\u0435 \u043C\u0435\u0441\u0442\u043E \u0434\u043B\u044F
      \u043A\u043B\u044E\u0447\u0430 \u0438 \u043D\u0435 \u043D\u0430\u0439\u0434\u0451\u0448\u044C."
    - "\u041C\u043E\u0436\u0435\u0442, \u043E\u043D \u043F\u043E\u0434\u043E\u0439\u0434\u0451\u0442
      \u0434\u043B\u044F \u0442\u043E\u0439 \u0434\u0432\u0435\u0440\u0438?"
  _english:
  - texts:
    - You couldn't find a better place for the key.
    - Maybe it'll fit that door?
  _currentLanguage: []
  ChangeGameStageOnEndDialogue: 0
