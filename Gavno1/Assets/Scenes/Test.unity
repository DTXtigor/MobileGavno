--- !u!114 &1996881361
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1996881356}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: e099c8b13a2ef1549a7e03cec25b3867, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::MainD
  _dialogue: {fileID: 0}
  _russian:
  - texts:
    - "\u0422\u0430\u043A \u0442\u044B \u0443\u0436\u0435 \u0443\u0445\u043E\u0434\u0438\u0448\u044C?"
    - "\u0410 \u043D\u0435 \u0440\u0430\u043D\u043E\u0432\u0430\u0442\u043E \u043B\u0438?"
    - "\u0415\u0441\u043B\u0438 \u043D\u0435\u0442 \u0440\u0430\u0431\u043E\u0442\u044B
      \u044F \u0442\u0435\u0431\u0435 \u043D\u0430\u0439\u0434\u0443."
    - "\u041D\u0430 \u0432\u0442\u043E\u0440\u043E\u0439 \u044D\u0442\u0430\u0436
      \u043C\u043E\u0436\u0435\u0448\u044C \u0441\u0445\u043E\u0434\u0438\u0442\u044C
      \u043E\u0442\u0447\u0451\u0442 \u0440\u0430\u0441\u0441\u043F\u0435\u0447\u0430\u0442\u0430\u0442\u044C."
    - "\u0422\u0443\u0442 \u0432 \u043F\u0430\u043F\u043A\u0435 \u0438 \u043E\u0441\u0442\u0430\u0432\u044C\u0438\u0448\u044C
      \u0431\u0443\u043C\u0430\u0433\u0438."
    - "\u042F \u0442\u0435\u0431\u0435 \u0432\u0441\u0435\u0433\u0434\u0430 \u0440\u0430\u0431\u043E\u0442\u0443
      \u043D\u0430\u0439\u0434\u0443."
    - "\u0428\u0443\u0441\u0442\u0440\u0435\u0435 \u0431\u0435\u0433\u0438."
  - texts:
    - "\u0423 \u0442\u0435\u0431\u044F \u0435\u0449\u0451 \u0434\u0435\u043B\u0430
      \u043D\u0435 \u0437\u0430\u043A\u043E\u043D\u0447\u0435\u043D\u044B."
  - texts:
    - "\u0422\u0435\u0431\u0435 \u0437\u0430\u0440\u043F\u043B\u0430\u0442\u0430
      \u043F\u0440\u0438\u0445\u043E\u0434\u0438\u0442 \u043D\u0435 \u0437\u0430
      \u0442\u043E \u0447\u0442\u043E \u0442\u044B \u0434\u043E\u043C\u0430 \u0441\u0438\u0434\u0438\u0448\u044C."
  - texts:
    - "\u041D\u0435 \u0437\u0430\u0441\u0442\u0430\u0432\u043B\u044F\u0439 \u043F\u043E\u0432\u0442\u043E\u0440\u044F\u0442\u044C."
  _english:
  - texts:
    - So you're leaving already?
    - Isn't it a bit early for that?
    - If there's no work, I'll find you some.
    - You can head up to the second floor to print out the report.
    - Leave the papers here in the folder.
    - I'll always find work for you.
    - Get moving, quicker now.
  - texts:
    - You've still got unfinished business.
  - texts:
    - You're not getting paid to sit at home.
  - texts:
    - Don't make me repeat myself.
  _currentLanguage: []
  ChangeGameStageOnEndDialogue: 0
  ToStage: 1
