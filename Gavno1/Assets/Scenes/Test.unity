  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::StartDialogueCore
  _dialogue: {fileID: 0}
  _russian:
  - texts:
    - "\u041D\u0430\u043A\u043E\u043D\u0435\u0446-\u0442\u043E."
  _english:
  - texts:
    - Finally.
  _currentLanguage: []
  ChangeGameStageOnEndDialogue: 0
--- !u!114 &8146356953772208719
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 5124115267676818487}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: fb14332ba0382854a8eb4ef1f8910427, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::StartDialogueCore
  _dialogue: {fileID: 0}
  _russian:
  - texts:
    - "\u041D\u0443 \u043A\u043E\u043D\u0435\u0447\u043D\u043E \u043E\u043D \u043D\u0435
      \u0432\u043A\u043B\u044E\u0447\u0438\u0442\u044C\u0441\u044F."
    - "\u0427\u044C\u0435 \u044D\u0442\u043E \u043C\u0435\u0441\u0442\u043E?"
    - "\u041C\u043E\u0436\u0435\u0442 \u0435\u0441\u0442\u044C \u0438\u043D\u0441\u0442\u0440\u0443\u043A\u0446\u0438\u0438
      \u043F\u043E \u0432\u043A\u043B\u044E\u0447\u0435\u043D\u0438\u044E?"
    - "\u0410 \u0432\u0434\u0440\u0443\u0433 \u0432\u0441\u0451 \u043B\u0435\u0433\u043A\u043E."
  _english:
  - texts:
    - Of course it won't turn on.
    - Whose workstation is this?
    - 'There might be some instructions. '
    - It might be easier than I think.
  _currentLanguage: []
  ChangeGameStageOnEndDialogue: 0
